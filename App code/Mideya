        <!-- 3. Brightness Swipe HUD (Left side) -->
        <div id="brightnessHud" class="absolute left-6 top-1/2 -translate-y-1/2 glass-panel px-3.5 py-4 rounded-2xl flex flex-col items-center gap-3 pointer-events-none z-30 hidden shadow-2xl border border-white/20 min-w-[55px]">
          <i id="brightIcon" class="fa-regular fa-sun text-yellow-300 text-base"></i>
