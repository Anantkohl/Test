<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ApexStream - MX & MovieBox Pro Web Player</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: '#00d2ff',
            brandDark: '#0072ff',
            neonOrange: '#ff6a00',
            oled: '#0a0a0c',
            surface: '#141418',
            surfaceLighter: '#1f1f26'
          }
        }
      }
    }
  </script>
  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #0c0d12; }
    ::-webkit-scrollbar-thumb { background: #2b2e3b; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #00d2ff; }

    /* Video player sizing & aspect ratios */
    .aspect-fit { object-fit: contain; }
    .aspect-fill { object-fit: cover; }
    .aspect-stretch { object-fit: fill; }
    .aspect-16-9 { aspect-ratio: 16/9; object-fit: cover; }

    /* Custom range sliders */
    input[type=range] {
      -webkit-appearance: none;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 9999px;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 14px;
      width: 14px;
      border-radius: 50%;
      background: #00d2ff;
      box-shadow: 0 0 10px rgba(0, 210, 255, 0.8);
      cursor: pointer;
    }

    /* Video Progress Slider */
    .progress-bar-container:hover .progress-scrub-thumb {
      transform: scale(1.3);
      opacity: 1;
    }

    /* Glassmorphism helpers */
    .glass-panel {
      background: rgba(18, 18, 24, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .sheet-up {
      transform: translateY(0%);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sheet-down {
      transform: translateY(105%);
      transition: transform 0.22s ease-in;
    }

    /* Fullscreen layout lock */
    #playerContainer:fullscreen,
    #playerContainer:-webkit-full-screen {
      width: 100vw !important;
      height: 100vh !important;
      max-width: 100vw !important;
      border-radius: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      background: #000;
    }

    /* Pulsing animations */
    @keyframes ping-slow {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .animate-pulse-glow {
      animation: ping-slow 2s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-oled text-gray-100 font-sans min-h-screen flex flex-col select-none antialiased">

  <!-- Top App Navigation Bar -->
  <header class="w-full glass-panel sticky top-0 z-40 px-4 py-2.5 flex items-center justify-between border-b border-white/10">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brandDark to-brand flex items-center justify-center text-black font-extrabold shadow-lg shadow-cyan-500/20">
        <i class="fa-solid fa-play text-sm"></i>
      </div>
      <div>
        <h1 class="text-base sm:text-lg font-bold tracking-tight bg-gradient-to-r from-white via-gray-200 to-brand bg-clip-text text-transparent">ApexStream <span class="text-xs px-1.5 py-0.5 rounded bg-brand/20 text-brand font-medium">PRO</span></h1>
        <p class="text-[10px] text-gray-400 font-medium">MX & MovieBox Engine</p>
      </div>
    </div>

    <!-- Right Quick Actions -->
    <div class="flex items-center space-x-2">
