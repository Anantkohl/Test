                </button>
              </div>

            </div>

          </div>

        </div>

        <!-- ==================== SPEED BOTTOM SHEET (Image 2 style) ==================== -->
        <div id="speedSheetBackdrop" class="absolute inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-end justify-center transition-opacity" onclick="closeSpeedSheet(event)">
          <div class="w-full max-w-lg bg-surface border-t border-white/15 rounded-t-3xl p-5 text-white shadow-2xl sheet-up" onclick="event.stopPropagation()">
            <!-- Drag Indicator Handle -->
