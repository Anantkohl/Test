  </main>

  <!-- URL Modal -->
  <div id="urlModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-surface border border-white/15 p-6 rounded-2xl max-w-md w-full shadow-2xl">
      <h3 class="text-base font-bold text-white mb-2 flex items-center gap-2">
        <i class="fa-solid fa-satellite-dish text-brand"></i> Online Stream Video URL
      </h3>
      <p class="text-xs text-gray-400 mb-4">Enter any direct MP4, MKV or WebM online file link to stream directly with all MX gestures & speed features.</p>
      <input type="text" id="modalUrlInput" placeholder="https://domain.com/video.mp4" class="w-full bg-oled border border-white/15 rounded-xl px-3.5 py-2.5 text-sm text-white mb-4 focus:outline-none focus:border-brand">
      <div class="flex justify-end gap-2">
        <button onclick="toggleUrlModal()" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-semibold">Cancel</button>
        <button onclick="submitModalUrl()" class="px-4 py-2 rounded-xl bg-brand text-black font-bold text-xs hover:bg-brandDark transition">Stream Now</button>
      </div>
    </div>
  </div>

  <script>
    /* =========================================================
       APEXSTREAM - MX PLAYER & MOVIEBOX PRO ENGINE SCRIPT
       ========================================================= */

    // DOM References
    const video = document.getElementById('mainVideo');
    const playerContainer = document.getElementById('playerContainer');
    const gestureSurface = document.getElementById('gestureSurface');
    const controlsOverlay = document.getElementById('controlsOverlay');
    const videoSource = document.getElementById('videoSource');
    const centerPlayBtn = document.getElementById('centerPlayBtn');
    const centerPlayIcon = document.getElementById('centerPlayIcon');
    const progressFill = document.getElementById('progressFill');
    const bufferFill = document.getElementById('bufferFill');
    const scrubKnob = document.getElementById('scrubKnob');
    const progressBarTrack = document.getElementById('progressBarTrack');
    const curTimeDisplay = document.getElementById('curTimeDisplay');
    const durTimeDisplay = document.getElementById('durTimeDisplay');
    const currentSpeedLabel = document.getElementById('currentSpeedLabel');
    const sheetSpeedVal = document.getElementById('sheetSpeedVal');
    const speedSlider = document.getElementById('speedSlider');
    const speedSheetBackdrop = document.getElementById('speedSheetBackdrop');
    const hold2XBadge = document.getElementById('hold2XBadge');
    const leftSeekRipple = document.getElementById('leftSeekRipple');
    const rightSeekRipple = document.getElementById('rightSeekRipple');
    const brightnessHud = document.getElementById('brightnessHud');
    const brightBarFill = document.getElementById('brightBarFill');
    const brightValText = document.getElementById('brightValText');
    const volumeHud = document.getElementById('volumeHud');
    const volumeBarFill = document.getElementById('volumeBarFill');
    const volumeValText = document.getElementById('volumeValText');
    const fsIcon = document.getElementById('fsIcon');
    const lockStateBanner = document.getElementById('lockStateBanner');
    const aspectRatioLabel = document.getElementById('aspectRatioLabel');
    const sleepTimerBadge = document.getElementById('sleepTimerBadge');
    const customSubtitleBox = document.getElementById('customSubtitleBox');
    const playlistContainer = document.getElementById('playlistContainer');

    // Default Sample Video Playlist (Royalty-free)
    const playlist = [
      {
        id: 'bb_bunny',
        title: 'Big Buck Bunny (Animation HD)',
        url: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4',
        duration: '09:56',
        badge: '1080P',
        thumb: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?w=400&q=80'
      },
      {
        id: 'tears_steel',
        title: 'Tears of Steel (Sci-Fi 4K)',
        url: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4',
        duration: '12:14',
        badge: '4K HDR',
        thumb: 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400&q=80'
      },
      {
        id: 'sintel_movie',
        title: 'Sintel - The Dragon Seeker',
        url: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/Sintel.mp4',
        duration: '00:52',
        badge: 'HD',
        thumb: 'https://images.unsplash.com/photo-1534447677768-be436bb09401?w=400&q=80'
      },
      {
        id: 'elephant_dream',
        title: 'Elephants Dream (Classic CGI)',
        url: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4',
        duration: '10:53',
        badge: '1080P',
        thumb: 'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=400&q=80'
      }
    ];

    let currentTrackIndex = 0;

    // State Variables
    let brightness = 1.0;          // 0.2 to 2.0
    let volume = 1.0;              // 0.0 to 1.0
    let currentSpeed = 1.0;
    let isScreenLocked = false;
    let controlsTimer = null;
    let hudTimer = null;
    let sleepTimerRef = null;
    let sleepTimeMinutes = 0; // 0 = off, 15, 30, 45
    let aspectModes = ['aspect-fit', 'aspect-fill', 'aspect-stretch', 'aspect-16-9'];
    let aspectModeNames = ['Fit', 'Fill', 'Stretch', '16:9'];
    let currentAspectIdx = 0;

    // Audio Boost Context Simulator
    let audioCtx = null;
    let biquadFilter = null;
    let isBassBoosted = false;

    // =========================================================
    // INITIALIZATION & PLAYLIST RENDER
    // =========================================================
    function initPlaylist() {
      playlistContainer.innerHTML = '';
      playlist.forEach((item, index) => {
        const isActive = index === currentTrackIndex;
        const el = document.createElement('div');
        el.className = `p-2.5 rounded-xl border transition cursor-pointer flex items-center gap-3 ${
          isActive 
            ? 'bg-brand/10 border-brand text-white shadow-lg shadow-brand/10' 
            : 'bg-surfaceLighter/60 hover:bg-surfaceLighter border-white/5 text-gray-300'
        }`;
        el.onclick = () => loadPlaylistItem(index);
        el.innerHTML = `
          <div class="relative w-16 h-12 rounded-lg overflow-hidden bg-black flex-shrink-0">
            <img src="${item.thumb}" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/120x80/202028/ffffff?text=Video'">
            <span class="absolute bottom-1 right-1 bg-black/80 text-[8px] px-1 rounded font-mono text-gray-200">${item.duration}</span>
          </div>
          <div class="flex-1 truncate">
            <p class="text-xs font-semibold truncate ${isActive ? 'text-brand' : 'text-white'}">${item.title}</p>
            <div class="flex items-center gap-1.5 mt-1 text-[10px] text-gray-400">
              <span class="px-1 py-0.2 rounded bg-white/10 text-white font-mono">${item.badge}</span>
              <span>•</span>
              <span>Available</span>
            </div>
          </div>
          ${isActive ? '<i class="fa-solid fa-chart-simple text-brand text-xs animate-pulse"></i>' : ''}
        `;
        playlistContainer.appendChild(el);
      });
    }

    function loadPlaylistItem(index) {
      if (index < 0 || index >= playlist.length) return;
      currentTrackIndex = index;
      const media = playlist[index];
      
      // Update UI Meta
      document.getElementById('videoTitleDisplay').textContent = media.title;
      document.getElementById('videoMetaHeading').textContent = media.title;
      document.getElementById('metaResBadge').textContent = media.badge;

      // Check Saved Progress
      const savedTime = localStorage.getItem('apex_progress_' + media.id);

      video.pause();
      video.src = media.url;
      video.load();

      video.onloadedmetadata = () => {
        if (savedTime && parseFloat(savedTime) < video.duration - 5) {
          video.currentTime = parseFloat(savedTime);
        }
        applyPlaybackSpeed(currentSpeed);
        video.play().catch(e => console.log('Autoplay restriction resolved:', e));
      };

      initPlaylist();
    }

    // =========================================================
    // VIDEO PLAYBACK & PROGRESS HANDLERS
    // =========================================================
    function togglePlayPause() {
      if (isScreenLocked) return;
      if (video.paused || video.ended) {
        video.play();
      } else {
        video.pause();
      }
      resetControlsTimer();
    }

    video.addEventListener('play', () => {
      centerPlayIcon.className = 'fa-solid fa-pause text-xl sm:text-2xl';
      resetControlsTimer();
    });

    video.addEventListener('pause', () => {
      centerPlayIcon.className = 'fa-solid fa-play text-xl sm:text-2xl ml-0.5';
      showControls();
    });

    video.addEventListener('timeupdate', () => {
      if (!video.duration) return;
      const cur = video.currentTime;
      const dur = video.duration;
      const pct = (cur / dur) * 100;
      
      progressFill.style.width = `${pct}%`;
      scrubKnob.style.left = `${pct}%`;
      curTimeDisplay.textContent = formatTime(cur);
      durTimeDisplay.textContent = formatTime(dur);

      // Save state in LocalStorage for auto-resume
      const curMedia = playlist[currentTrackIndex];
      if (curMedia) {
        localStorage.setItem('apex_progress_' + curMedia.id, cur);
      }
    });

    video.addEventListener('progress', () => {
      if (video.buffered.length > 0 && video.duration) {
        const bufferedEnd = video.buffered.end(video.buffered.length - 1);
        const buffPct = (bufferedEnd / video.duration) * 100;
        bufferFill.style.width = `${buffPct}%`;
      }
    });

    function formatTime(sec) {
      if (isNaN(sec)) return "00:00";
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = Math.floor(sec % 60);
      if (h > 0) {
        return `${h}:${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
      }
      return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
    }

    // Scrubbing on Progress Bar
    let isScrubbing = false;
    function handleProgressScrub(e) {
      const rect = progressBarTrack.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const pos = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      if (video.duration) {
        video.currentTime = pos * video.duration;
      }
    }

    progressBarTrack.addEventListener('click', (e) => {
      if (isScreenLocked) return;
      handleProgressScrub(e);
    });

    progressBarTrack.addEventListener('mousedown', (e) => {
      if (isScreenLocked) return;
      isScrubbing = true;
      handleProgressScrub(e);
    });
    window.addEventListener('mousemove', (e) => {
      if (isScrubbing) handleProgressScrub(e);
    });
    window.addEventListener('mouseup', () => { isScrubbing = false; });

    // =========================================================
    // MX-STYLE SIGNATURE GESTURES (SWIPE, DOUBLE-TAP, 2X HOLD)
    // =========================================================
    let touchStartX = 0;
    let touchStartY = 0;
    let lastTapTime = 0;
    let holdTimer = null;
    let isHolding2X = false;
    let isVerticalSwipe = false;
    let activeSwipeSide = null; // 'left' (bright) or 'right' (vol)

    gestureSurface.addEventListener('touchstart', (e) => {
      if (isScreenLocked) return;
      const touch = e.touches[0];
      const rect = playerContainer.getBoundingClientRect();
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      isVerticalSwipe = false;

      // Determine screen side
      activeSwipeSide = (touch.clientX - rect.left) < (rect.width / 2) ? 'left' : 'right';

      // Double-Tap Seek detection (< 300ms)
      const now = Date.now();
      if (now - lastTapTime < 300) {
        clearTimeout(holdTimer);
        const isRight = (touch.clientX - rect.left) > (rect.width / 2);
        seekOffset(isRight ? 10 : -10);
        showSeekRipple(isRight ? 'right' : 'left');
        lastTapTime = 0;
        return;
      }
      lastTapTime = now;

      // Long press 2X Speed Hold trigger (450ms)
      holdTimer = setTimeout(() => {
        if (!video.paused) {
          isHolding2X = true;
          video.playbackRate = 2.0;
          hold2XBadge.classList.remove('hidden');
        }
      }, 450);

      resetControlsTimer();
    }, { passive: true });

    gestureSurface.addEventListener('touchmove', (e) => {
      if (isScreenLocked) return;
      const touch = e.touches[0];
      const deltaY = touchStartY - touch.clientY; // Up = positive
      const deltaX = Math.abs(touch.clientX - touchStartX);

      if (Math.abs(deltaY) > 10 && Math.abs(deltaY) > deltaX) {
        // Confirmed vertical swipe
        isVerticalSwipe = true;
        clearTimeout(holdTimer);

        const sensitivity = 0.007;
        if (activeSwipeSide === 'left') {
          // Brightness Control
          adjustBrightness(brightness + (deltaY * sensitivity));
        } else {
          // Volume Control
          adjustVolume(volume + (deltaY * sensitivity));
        }
        touchStartY = touch.clientY;
      }
    }, { passive: true });

    gestureSurface.addEventListener('touchend', endGesture);
    gestureSurface.addEventListener('touchcancel', endGesture);

    function endGesture() {
      clearTimeout(holdTimer);
      if (isHolding2X) {
        applyPlaybackSpeed(currentSpeed);
        hold2XBadge.classList.add('hidden');
        isHolding2X = false;
      }
      if (!isVerticalSwipe) {
        toggleControlsVisibility();
      }
      isVerticalSwipe = false;
    }

    // Mouse Fallbacks for Desktop
    gestureSurface.addEventListener('click', (e) => {
      if (isScreenLocked) return;
      toggleControlsVisibility();
    });

    gestureSurface.addEventListener('dblclick', (e) => {
      if (isScreenLocked) return;
      const rect = playerContainer.getBoundingClientRect();
      const isRight = (e.clientX - rect.left) > (rect.width / 2);
      seekOffset(isRight ? 10 : -10);
      showSeekRipple(isRight ? 'right' : 'left');
    });

    // =========================================================
    // HUD CONTROLS (BRIGHTNESS, VOLUME, SEEK RIPPLES)
    // =========================================================
    function adjustBrightness(val) {
      brightness = Math.max(0.2, Math.min(val, 2.0));
      video.style.filter = `brightness(${brightness})`;
      
      const pct = Math.round((brightness / 2.0) * 100);
      brightValText.textContent = `${pct}%`;
      brightBarFill.style.height = `${pct}%`;

      brightnessHud.classList.remove('hidden');
      clearTimeout(hudTimer);
      hudTimer = setTimeout(() => {
        brightnessHud.classList.add('hidden');
      }, 1200);
    }

    function adjustVolume(val) {
      volume = Math.max(0, Math.min(val, 1.0));
      video.volume = volume;

      const pct = Math.round(volume * 100);
      volumeValText.textContent = pct === 0 ? 'Mute' : `${pct}%`;
      volumeBarFill.style.height = `${pct}%`;

      volumeHud.classList.remove('hidden');
      clearTimeout(hudTimer);
      hudTimer = setTimeout(() => {
        volumeHud.classList.add('hidden');
      }, 1200);
    }

    function seekOffset(seconds) {
      if (!video.duration) return;
      video.currentTime = Math.max(0, Math.min(video.currentTime + seconds, video.duration));
    }

    function showSeekRipple(side) {
      const el = side === 'left' ? leftSeekRipple : rightSeekRipple;
      el.classList.remove('hidden');
      el.classList.add('flex');
      setTimeout(() => {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }, 650);
    }

    // =========================================================
    // SPEED CONTROL SHEET (IMAGE 2 STYLE)
    // =========================================================
    function openSpeedSheet() {
      if (isScreenLocked) return;
      speedSheetBackdrop.classList.remove('hidden');
      speedSheetBackdrop.classList.add('flex');
      updateSpeedUI(currentSpeed);
      hideControls();
    }

    function closeSpeedSheet() {
      speedSheetBackdrop.classList.add('hidden');
      speedSheetBackdrop.classList.remove('flex');
      resetControlsTimer();
    }

    function applyPlaybackSpeed(spd) {
      currentSpeed = parseFloat(spd);
      video.playbackRate = currentSpeed;
      updateSpeedUI(currentSpeed);
    }

    function onSpeedSliderInput(val) {
      applyPlaybackSpeed(val);
    }

    function nudgeSpeed(delta) {
      let next = Math.round((currentSpeed + delta) * 100) / 100;
      next = Math.max(0.25, Math.min(next, 2.5));
      applyPlaybackSpeed(next);
    }

    function selectSpeedPreset(preset) {
      applyPlaybackSpeed(preset);
    }

    function updateSpeedUI(val) {
      const fixedStr = Number(val).toFixed(2) + 'x';
      const cleanLabel = (val % 1 === 0 ? Number(val).toFixed(1) : val) + 'x';

      sheetSpeedVal.textContent = fixedStr;
      currentSpeedLabel.textContent = cleanLabel;
      speedSlider.value = val;

      // Update Pill styles
      document.querySelectorAll('.speed-pill').forEach(btn => {
        const pVal = parseFloat(btn.textContent.trim());
        if (Math.abs(pVal - val) < 0.02) {
          btn.className = "speed-pill py-2 rounded-xl bg-brand text-black font-bold border border-brand shadow-lg shadow-brand/20";
        } else {
          btn.className = "speed-pill py-2 rounded-xl bg-surfaceLighter hover:bg-white/15 text-gray-300 font-semibold border border-white/5";
        }
      });
    }

    // =========================================================
    // TRUE FULLSCREEN & PICTURE-IN-PICTURE
    // =========================================================
    async function toggleProFullscreen() {
      const isFs = document.fullscreenElement || document.webkitFullscreenElement;
      try {
        if (!isFs) {
          if (playerContainer.requestFullscreen) {
            await playerContainer.requestFullscreen();
          } else if (playerContainer.webkitRequestFullscreen) {
            await playerContainer.webkitRequestFullscreen();
          }
        } else {
          if (document.exitFullscreen) {
            await document.exitFullscreen();
          } else if (document.webkitExitFullscreen) {
            await document.webkitExitFullscreen();
          }
        }
      } catch (e) {
        console.error('Fullscreen toggling error:', e);
      }
    }

    function handleFullscreenChange() {
      const isFs = document.fullscreenElement || document.webkitFullscreenElement;
      if (isFs) {
        fsIcon.className = "fa-solid fa-compress text-base";
      } else {
        fsIcon.className = "fa-solid fa-expand text-base";
      }
    }
    document.addEventListener('fullscreenchange', handleFullscreenChange);
    document.addEventListener('webkitfullscreenchange', handleFullscreenChange);

    async function togglePictureInPicture() {
      try {
        if (!document.pictureInPictureEnabled) {
          return;
        }
        if (document.pictureInPictureElement) {
          await document.exitPictureInPicture();
        } else {
          await video.requestPictureInPicture();
        }
      } catch (err) {
        console.error('PiP Error:', err);
      }
    }

    // =========================================================
    // ASPECT RATIO & SCREEN LOCK
    // =========================================================
    function cycleAspectRatio() {
      if (isScreenLocked) return;
      // remove old class
      video.classList.remove(...aspectModes);
      currentAspectIdx = (currentAspectIdx + 1) % aspectModes.length;
      video.classList.add(aspectModes[currentAspectIdx]);
      aspectRatioLabel.textContent = aspectModeNames[currentAspectIdx];
      resetControlsTimer();
    }

    function toggleScreenLock() {
      isScreenLocked = !isScreenLocked;
      if (isScreenLocked) {
        hideControls();
        lockStateBanner.classList.remove('hidden');
      } else {
        lockStateBanner.classList.add('hidden');
        showControls();
      }
    }

    // =========================================================
    // SLEEP TIMER FEATURE
    // =========================================================
    function cycleSleepTimer() {
      if (isScreenLocked) return;
      if (sleepTimeMinutes === 0) sleepTimeMinutes = 15;
      else if (sleepTimeMinutes === 15) sleepTimeMinutes = 30;
      else if (sleepTimeMinutes === 30) sleepTimeMinutes = 45;
      else sleepTimeMinutes = 0;

      clearTimeout(sleepTimerRef);
      if (sleepTimeMinutes > 0) {
        sleepTimerBadge.textContent = `${sleepTimeMinutes}m`;
        sleepTimerBadge.classList.remove('hidden');
        sleepTimerRef = setTimeout(() => {
          video.pause();
          sleepTimerBadge.classList.add('hidden');
          sleepTimeMinutes = 0;
        }, sleepTimeMinutes * 60 * 1000);
      } else {
        sleepTimerBadge.classList.add('hidden');
      }
    }

    // =========================================================
    // BASS BOOST SIMULATION (WEB AUDIO API)
    // =========================================================
    function toggleAudioBoost() {
      try {
        if (!audioCtx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AudioContext();
          const source = audioCtx.createMediaElementSource(video);
          biquadFilter = audioCtx.createBiquadFilter();
          biquadFilter.type = "lowshelf";
          biquadFilter.frequency.value = 200; // Bass freq
          biquadFilter.gain.value = 0;

          source.connect(biquadFilter);
          biquadFilter.connect(audioCtx.destination);
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        isBassBoosted = !isBassBoosted;
        if (isBassBoosted) {
          biquadFilter.gain.value = 8.5; // +8.5dB bass
          document.getElementById('bassBoostText').textContent = 'Heavy (+8dB)';
          document.getElementById('bassBoostText').className = 'text-brand font-bold';
        } else {
          biquadFilter.gain.value = 0;
          document.getElementById('bassBoostText').textContent = 'Off';
          document.getElementById('bassBoostText').className = 'text-white font-normal';
        }
      } catch (e) {
        console.log('Audio Context error or already linked:', e);
      }
    }

    // =========================================================
    // SUBTITLES & LOCAL FILES
    // =========================================================
    function toggleSubtitles() {
      const track = video.textTracks[0];
      if (track) {
        if (track.mode === 'showing') {
          track.mode = 'disabled';
          document.getElementById('subBtn').classList.remove('text-brand');
        } else {
          track.mode = 'showing';
          document.getElementById('subBtn').classList.add('text-brand');
        }
      }
    }

    // Local Subtitle File Upload
    document.getElementById('subtitleFileInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const url = URL.createObjectURL(file);
      const track = document.getElementById('mainTrack');
      track.src = url;
      track.mode = 'showing';
      document.getElementById('subBtn').classList.add('text-brand');
    });

    // Local Video File Upload
    document.getElementById('localFileInput').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const fileUrl = URL.createObjectURL(file);
      
      // Add to playlist
      const localItem = {
        id: 'local_' + Date.now(),
        title: file.name.replace(/\.[^/.]+$/, ""),
        url: fileUrl,
        duration: 'Local',
        badge: 'Local Disk',
        thumb: 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=400&q=80'
      };
      playlist.unshift(localItem);
      initPlaylist();
      loadPlaylistItem(0);
    });

    // =========================================================
    // URL STREAM MODAL
    // =========================================================
    function toggleUrlModal() {
      const modal = document.getElementById('urlModal');
      modal.classList.toggle('hidden');
      modal.classList.toggle('flex');
    }

    function submitModalUrl() {
      const url = document.getElementById('modalUrlInput').value.trim();
      if (!url) return;
      playCustomUrl(url);
      toggleUrlModal();
    }

    function loadFromInputUrl() {
      const url = document.getElementById('quickUrlInput').value.trim();
      if (!url) return;
      playCustomUrl(url);
    }

    function playCustomUrl(url) {
      let name = 'Online Stream';
      try {
        const u = new URL(url);
        name = u.pathname.split('/').pop() || 'Web Stream';
      } catch(e){}

      const item = {
        id: 'stream_' + Date.now(),
        title: decodeURIComponent(name),
        url: url,
        duration: 'Stream',
        badge: 'WEB',
        thumb: 'https://images.unsplash.com/photo-1485846234645-a62644f84728?w=400&q=80'
      };
      playlist.unshift(item);
      initPlaylist();
      loadPlaylistItem(0);
    }

    // =========================================================
    // CONTROLS AUTO-HIDE & VISIBILITY
    // =========================================================
    function showControls() {
      if (isScreenLocked) return;
      controlsOverlay.style.opacity = '1';
      controlsOverlay.style.pointerEvents = 'auto';
      resetControlsTimer();
    }

    function hideControls() {
      if (video.paused) return;
      controlsOverlay.style.opacity = '0';
      controlsOverlay.style.pointerEvents = 'none';
    }

    function toggleControlsVisibility() {
      if (isScreenLocked) return;
      if (controlsOverlay.style.opacity === '0') {
        showControls();
      } else {
        hideControls();
      }
    }

    function resetControlsTimer() {
      clearTimeout(controlsTimer);
      controlsTimer = setTimeout(() => {
        hideControls();
      }, 3500);
    }

    playerContainer.addEventListener('mousemove', () => {
      showControls();
    });

    // Start App
    window.onload = function() {
      initPlaylist();
      loadPlaylistItem(0);
      resetControlsTimer();
    };
  </script>

