      <label class="cursor-pointer bg-surfaceLighter hover:bg-white/10 text-xs px-3 py-1.5 rounded-lg border border-white/10 flex items-center gap-1.5 transition active:scale-95 text-gray-300 hover:text-white">
        <i class="fa-regular fa-folder-open text-brand"></i>
        <span class="hidden sm:inline">Open File</span>
        <input type="file" id="localFileInput" accept="video/*,.mkv,.mp4,.webm" class="hidden">
      </label>

      <!-- URL Input Toggle -->
      <button onclick="toggleUrlModal()" class="bg-surfaceLighter hover:bg-white/10 text-xs px-3 py-1.5 rounded-lg border border-white/10 flex items-center gap-1.5 transition active:scale-95 text-gray-300 hover:text-white">
        <i class="fa-solid fa-link text-neonOrange"></i>
        <span class="hidden sm:inline">Stream URL</span>
      </button>

      <!-- Subtitle File Loader -->
      <label class="cursor-pointer bg-surfaceLighter hover:bg-white/10 text-xs px-3 py-1.5 rounded-lg border border-white/10 flex items-center gap-1.5 transition active:scale-95 text-gray-300 hover:text-white" title="Load .srt or .vtt Subtitles">
        <i class="fa-solid fa-closed-captioning text-green-400"></i>
        <span class="hidden md:inline">Subtitle</span>
        <input type="file" id="subtitleFileInput" accept=".vtt,.srt" class="hidden">
      </label>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 w-full max-w-7xl mx-auto p-2 sm:p-4 lg:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

