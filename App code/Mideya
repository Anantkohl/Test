        <div id="hold2XBadge" class="absolute top-5 left-1/2 -translate-x-1/2 bg-black/85 text-yellow-400 border border-yellow-400/60 px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold flex items-center gap-2 shadow-xl pointer-events-none z-30 hidden animate-pulse">
