              <button onclick="selectSpeedPreset(1.75)" class="speed-pill py-2 rounded-xl bg-surfaceLighter hover:bg-white/15 text-gray-300 font-semibold border border-white/5">1.75</button>
              <button onclick="selectSpeedPreset(2.0)" class="speed-pill py-2 rounded-xl bg-surfaceLighter hover:bg-white/15 text-gray-300 font-semibold border border-white/5">2.0</button>
              <button onclick="selectSpeedPreset(2.25)" class="speed-pill py-2 rounded-xl bg-surfaceLighter hover:bg-white/15 text-gray-300 font-semibold border border-white/5">2.25</button>
              <button onclick="selectSpeedPreset(2.5)" class="speed-pill py-2 rounded-xl bg-surfaceLighter hover:bg-white/15 text-gray-300 font-semibold border border-white/5">2.5</button>
            </div>
          </div>
        </div>

      </div><!-- /Player Container -->

      <!-- Video Meta Details Bar -->
      <div class="glass-panel p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 border border-white/10">
        <div>
          <h2 id="videoMetaHeading" class="text-base sm:text-lg font-bold text-white">Big Buck Bunny (2008)</h2>
          <div class="flex items-center gap-2 mt-1 text-xs text-gray-400">
            <span class="text-brand font-medium"><i class="fa-solid fa-circle-check text-[10px]"></i> Blender Open Movie</span>
            <span>•</span>
            <span id="metaResBadge">Full HD 1080p</span>
            <span>•</span>
            <span>Stereo AAC</span>
