              <span id="videoTitleDisplay" class="font-semibold text-sm sm:text-base truncate drop-shadow">Big Buck Bunny (2008 Open Movie)</span>
            </div>

            <!-- Top Right Player Tools -->
            <div class="flex items-center space-x-2 sm:space-x-3 text-xs sm:text-sm">
              <!-- Aspect Ratio Cycle Button -->
              <button onclick="cycleAspectRatio()" class="hover:text-brand transition p-1.5" title="Toggle Aspect Ratio (Fit, Fill, Stretch)">
