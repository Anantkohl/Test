        <div class="mt-4 pt-3 border-t border-white/10">
          <p class="text-[11px] text-gray-400 mb-2">Have a direct MP4 / WebM stream URL?</p>
          <div class="flex items-center gap-1.5">
            <input type="text" id="quickUrlInput" placeholder="Paste media URL here..." class="flex-1 bg-surfaceLighter border border-white/10 rounded-xl px-3 py-2 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-brand">
            <button onclick="loadFromInputUrl()" class="bg-brand hover:bg-brandDark text-black font-bold text-xs px-3.5 py-2 rounded-xl transition active:scale-95">Play</button>
