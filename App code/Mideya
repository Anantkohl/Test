          </div>

          <!-- Bottom Row: Timeline + Action Buttons -->
          <div class="flex flex-col space-y-1.5 text-white">
            
            <!-- Video Progress Bar with Scrub Hover -->
            <div class="progress-bar-container relative w-full h-4 flex items-center cursor-pointer group/bar" id="progressBarTrack">
              <div class="w-full h-1 bg-white/25 rounded-full overflow-hidden relative group-hover/bar:h-2 transition-all">
                <!-- Buffer fill -->
                <div id="bufferFill" class="absolute top-0 left-0 h-full bg-white/30 rounded-full" style="width: 0%;"></div>
                <!-- Playback fill -->
                <div id="progressFill" class="absolute top-0 left-0 h-full bg-gradient-to-r from-brand to-brandDark rounded-full" style="width: 0%;"></div>
              </div>
              <!-- Scrub Knob -->
              <div id="scrubKnob" class="progress-scrub-thumb absolute w-3.5 h-3.5 bg-brand rounded-full shadow-md -translate-x-1/2 pointer-events-none transition-transform opacity-0 group-hover/bar:opacity-100" style="left: 0%;"></div>
