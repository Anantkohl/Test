    <!-- RIGHT: MovieBox Style Playlist & Media Hub (4 cols) -->
    <div class="lg:col-span-4 flex flex-col space-y-4">
      
      <!-- Playlist Header -->
      <div class="glass-panel p-4 rounded-2xl border border-white/10 flex flex-col h-full">
        <div class="flex items-center justify-between mb-3 border-b border-white/10 pb-3">
          <div class="flex items-center space-x-2">
