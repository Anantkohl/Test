        <!-- 2. Left / Right Double-Tap Seek Ripples -->
        <div id="leftSeekRipple" class="absolute left-6 top-1/2 -translate-y-1/2 bg-white/10 backdrop-blur-md text-white border border-white/20 px-5 py-3 rounded-full text-sm font-bold items-center gap-2 pointer-events-none z-30 hidden shadow-2xl">
          <i class="fa-solid fa-backward"></i> -10s
        </div>
        <div id="rightSeekRipple" class="absolute right-6 top-1/2 -translate-y-1/2 bg-white/10 backdrop-blur-md text-white border border-white/20 px-5 py-3 rounded-full text-sm font-bold items-center gap-2 pointer-events-none z-30 hidden shadow-2xl">
          +10s <i class="fa-solid fa-forward"></i>
