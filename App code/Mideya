      <!-- Video Player Wrapper (Responsive & Fullscreen target) -->
      <div id="playerContainer" class="relative w-full aspect-video bg-black rounded-2xl overflow-hidden shadow-2xl border border-white/10 group select-none">
        
        <!-- Video Element -->
        <video id="mainVideo" class="w-full h-full aspect-fit transition-all duration-200" playsinline preload="metadata">
          <source id="videoSource" src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" type="video/mp4">
          <track id="mainTrack" label="English" kind="subtitles" srclang="en" default>
          Your browser doesn't support HTML5 video.
        </video>

        <!-- SUBTITLES OVERLAY CONTAINER -->
        <div id="customSubtitleBox" class="absolute bottom-16 inset-x-4 text-center pointer-events-none z-20 text-white font-semibold text-sm sm:text-base md:text-lg drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)] bg-black/60 px-3 py-1 rounded max-w-max mx-auto hidden transition-opacity"></div>

        <!-- GESTURE INTERACTION SURFACE (Taps, Swipes, Longpress) -->
        <div id="gestureSurface" class="absolute inset-0 z-10 cursor-pointer"></div>

        <!-- ==================== FLOATING HUDS ==================== -->
