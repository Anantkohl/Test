              <i class="fa-solid fa-rotate-left text-sm sm:text-base"></i>
            </button>
            
            <button id="centerPlayBtn" onclick="togglePlayPause()" class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-brandDark to-brand text-black flex items-center justify-center shadow-lg shadow-cyan-500/30 transition transform hover:scale-105 active:scale-95" title="Play/Pause">
              <i id="centerPlayIcon" class="fa-solid fa-play text-xl sm:text-2xl ml-0.5"></i>
