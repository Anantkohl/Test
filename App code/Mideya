              <button onclick="selectSpeedPreset(0.5)" class="speed-pill py-2 rounded-xl bg-surfaceLighter hover:bg-white/15 text-gray-300 font-semibold border border-white/5">0.5</button>
              <button onclick="selectSpeedPreset(0.75)" class="speed-pill py-2 rounded-xl bg-surfaceLighter hover:bg-white/15 text-gray-300 font-semibold border border-white/5">0.75</button>
