        </div>

        <!-- ==================== MX PLAYER CONTROLS OVERLAY ==================== -->
        <div id="controlsOverlay" class="absolute inset-0 z-20 flex flex-col justify-between p-3 sm:p-5 bg-gradient-to-t from-black/90 via-transparent to-black/75 transition-opacity duration-300 pointer-events-auto">
          
          <!-- Top Row Controls -->
          <div class="flex items-center justify-between text-white">
            <div class="flex items-center space-x-2.5 truncate max-w-[70%]">
