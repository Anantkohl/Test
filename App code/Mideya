            <div class="flex items-center justify-between mb-4">
              <span class="text-xs uppercase font-bold text-gray-400 tracking-wider">Playback Speed</span>
              <span id="sheetSpeedVal" class="text-xl font-black text-brand font-mono">1.00x</span>
